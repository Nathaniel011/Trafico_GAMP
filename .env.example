APP_NAME="Trafico y Vialidad"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
MAPBOX_ACCESS_TOKEN=
APP_URL=https://trafico.example.com

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=certtrafico
DB_USERNAME=certtrafico
DB_PASSWORD=

LOG_CHANNEL=daily
LOG_LEVEL=warning
BROADCAST_CONNECTION=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=trafico@example.com
MAIL_FROM_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Cartografía web: proveedor de teselas configurable (uso sujeto a sus condiciones).
MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_MAX_ZOOM=19
GPS_ACCURACY_WARNING_METERS=25
MAP_ATTRIBUTION="&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors"
